 "constraints": [
  {
   "id": "C01",
   "text": "sequence_parallel requires TP > 1",
   "source": "core/model_parallel_config.py:415"
  },
  {
   "id": "C02",
   "text": "tp_comm_overlap requires sequence_parallel",
   "source": "training/arguments.py:1386"
  },
  {
   "id": "C03",
   "text": "full recompute needs method in {uniform, block} and num_layers >= 1; selective forbids num_layers (and method in L0)",
   "source": "core/transformer/transformer_config.py:1544-1575"
  },
  {
   "id": "C04",
   "text": "recompute_modules only with selective; allowed set; moe_act needs grouped GEMM; mla_up_proj needs MLA",
   "source": "core/transformer/transformer_config.py:1586-1612"
  },
  {
   "id": "C05",
   "text": "moe_layer_recompute is rejected with full granularity",
   "source": "core/transformer/transformer_config.py:1645-1651"
  },
  {
   "id": "C06",
   "text": "cpu_offloading needs 0 <= num_layers < model layers, PP == 1 and no recompute",
   "source": "core/transformer/transformer_config.py:1527-1543"
  },
  {
   "id": "C07",
   "text": "overlap_param_gather requires overlap_grad_reduce (distributed optimizer is a task constant)",
   "source": "training/arguments.py:1003-1008"
  },
  {
   "id": "C08",
   "text": "moe_enable_deepep requires the flex dispatcher",
   "source": "core/transformer/transformer_config.py:1440-1442"
  },
  {
   "id": "C09",
   "text": "moe_shared_expert_overlap requires alltoall or flex",
   "source": "core/transformer/transformer_config.py:1467-1473"
  },
  {
   "id": "C10",
   "text": "overlap_moe_expert_parallel_comm: EP>1, alltoall/flex, recompute not full, no recompute method/num_layers, no 'moe' recompute, no shared-expert overlap, PP == 1 (VPP not in L0)",
   "source": "core/transformer/transformer_config.py:2399-2441"
  },
  {
   "id": "C11",
   "text": "delay_wgrad_compute requires overlap_moe_expert_parallel_comm",
   "source": "core/transformer/transformer_config.py:2454-2457"
  },
  {
   "id": "C12",
   "text": "cross_entropy_loss_fusion with impl 'te' is rejected",
   "source": "training/arguments.py:1529-1534"
  },
  {
   "id": "C13",
   "text": "world % (TP*PP*CP) == 0 and world % (ETP*EP*PP) == 0",
   "source": "core/parallel_state.py:735,787"
  },
  {
   "id": "C14",
   "text": "packs_per_update % (DP*MBS) == 0 (integer GA, fixed GBS)",
   "source": "INTERFACES.md 4b update_assignment"
  },
  {
   "id": "C15",
   "text": "TP <= GPUs per node and divides it (TP inside NVLink)",
   "source": "design 1.5 rule"
  },
  {
   "id": "C16",
   "text": "attention heads % TP == 0; query groups % TP == 0, or TP % query groups == 0 when groups < TP",
   "source": "core/transformer/attention.py:331-347"
  },
  {
   "id": "C17",
   "text": "num_experts % EP == 0; dense models need EP == 1",
   "source": "core/transformer/moe/moe_layer.py:185"
  },
  {
   "id": "C18",
   "text": "num_layers % PP == 0 (uniform split); full recompute num_layers <= num_layers/PP",
   "source": "core/transformer/transformer_config.py:1562-1567"
  },
  {
   "id": "C19",
   "text": "SFT tasks (data D-SFT-*) need CP in {1, 2, 4} (segments padded to multiples of 8; rejected before any screen); seq_len % (2*CP) == 0; cp_comm_type only with CP > 1",
   "source": "core/transformer/transformer_config.py:2483; design 1.2; data contract (coordinator 2026-10-20)"
  },
  {
   "id": "C20",
   "text": "moe_deepep_num_sms must be even",
   "source": "flash-next code/vendor/DeepEP-fp32-combine/deep_ep/buffer.py:138"
  },
  {
   "id": "C21",
   "text": "MoE-only keys have no effect on dense models (warning); samplers skip them",
   "source": "design 1.8"
  },
  {
   "id": "C22",
   "text": "average_in_collective must be false (per-token loss)",
   "source": "core/distributed/distributed_data_parallel.py:169-172"
  }
 ]
